# ─────────────────────────────────────────────────────────────
# SALON ONE API 連携設定
# このファイルをコピーして `.env.local` を作成し、値を設定してください。
#   cp .env.example .env.local
# `.env.local` は .gitignore 済みのためコミットされません。
# ─────────────────────────────────────────────────────────────

# SALON ONE 分析用 APIキー（サーバー側のみで使用・クライアントには露出しない）
SALONONE_API_KEY=so_analytics_xxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SALON ONE API のベースURL（実際のエンドポイントが判明したら差し替え）
SALONONE_API_BASE_URL=https://salonone.net/api

# モックデータで動かすか実APIを叩くか。
#   true  … lib/salonone/mock.ts のサンプルデータを返す（API未接続でもUI確認可）
#   false … SALONONE_API_BASE_URL の実エンドポイントへリクエスト
SALONONE_USE_MOCK=true
